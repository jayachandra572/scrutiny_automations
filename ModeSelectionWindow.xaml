<Window x:Class="BatchProcessor.ModeSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Batch Processor - Select Mode" Height="850" Width="950"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        MinHeight="750" MinWidth="850"
        Background="#F5F5F5">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="20,15">
            <StackPanel>
                <TextBlock Text="🎯 AutoCAD Batch Processor" 
                          FontSize="22" 
                          FontWeight="Bold" 
                          Foreground="White" 
                          HorizontalAlignment="Center"/>
                <TextBlock Text="Select the mode you want to use" 
                          FontSize="12" 
                          Foreground="#ECF0F1" 
                          HorizontalAlignment="Center" 
                          Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Mode Selection Cards - Compact Grid Layout -->
        <Grid Grid.Row="1" Margin="25,15">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Pre Scrutiny Validations Mode -->
            <Border Grid.Row="0"
                   Background="White" 
                   CornerRadius="8" 
                   Padding="15"
                   Cursor="Hand"
                   MouseLeftButtonDown="Border_CommandsMode_Click"
                   BorderThickness="2"
                   BorderBrush="#3498DB"
                   Margin="0,0,0,10">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#2980B9"/>
                                <Setter Property="Background" Value="#EBF5FB"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Icon -->
                    <TextBlock Grid.Column="0"
                              Text="⚙️" 
                              FontSize="36" 
                              VerticalAlignment="Center"
                              Margin="0,0,15,0"/>
                    
                    <!-- Content -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Pre Scrutiny Validations" 
                                  FontSize="18" 
                                  FontWeight="Bold" 
                                  Margin="0,0,0,8"
                                  Foreground="#2C3E50"/>
                        <TextBlock TextWrapping="Wrap" 
                                  Foreground="#7F8C8D"
                                  FontSize="12"
                                  LineHeight="18">
                            <Run Text="Process AutoCAD drawings in batch mode. Execute RunPreScrutinyValidationsBatch command on multiple DWG files and generate JSON output files."/>
                        </TextBlock>
                    </StackPanel>
                    
                    <!-- Button -->
                    <Button Grid.Column="2"
                           x:Name="BtnCommandsMode" 
                           Content="Select" 
                           Margin="15,0,0,0"
                           Padding="25,12"
                           VerticalAlignment="Center"
                           Background="#3498DB"
                           Foreground="White"
                           FontSize="14"
                           FontWeight="Bold"
                           BorderThickness="0"
                           Click="BtnCommandsMode_Click"
                           Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2980B9"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- Scrutiny Reports Generation Mode -->
            <Border Grid.Row="1"
                   Background="White"
                   CornerRadius="8"
                   Padding="15"
                   Cursor="Hand"
                   MouseLeftButtonDown="Border_ReportsMode_Click"
                   BorderThickness="2"
                   BorderBrush="#9B59B6"
                   Margin="0,0,0,10">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#8E44AD"/>
                                <Setter Property="Background" Value="#F4ECF7"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icon -->
                    <TextBlock Grid.Column="0"
                              Text="📊"
                              FontSize="36"
                              VerticalAlignment="Center"
                              Margin="0,0,15,0"/>

                    <!-- Content -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Scrutiny Reports Generation"
                                  FontSize="18"
                                  FontWeight="Bold"
                                  Margin="0,0,0,8"
                                  Foreground="#2C3E50"/>
                        <TextBlock TextWrapping="Wrap"
                                  Foreground="#7F8C8D"
                                  FontSize="12"
                                  LineHeight="18">
                            <Run Text="Generate scrutiny report files for multiple DWG files using the GenerateScrutinyReportBatch command and Crx DLL."/>
                        </TextBlock>
                    </StackPanel>

                    <!-- Button -->
                    <Button Grid.Column="2"
                           x:Name="BtnReportsMode"
                           Content="Select"
                           Margin="15,0,0,0"
                           Padding="25,12"
                           VerticalAlignment="Center"
                           Background="#9B59B6"
                           Foreground="White"
                           FontSize="14"
                           FontWeight="Bold"
                           BorderThickness="0"
                           Click="BtnReportsMode_Click"
                           Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#8E44AD"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- Bulk Download and Process Mode -->
            <Border Grid.Row="2"
                   Background="White"
                   CornerRadius="8"
                   Padding="15"
                   Cursor="Hand"
                   MouseLeftButtonDown="Border_DownloadMode_Click"
                   BorderThickness="2"
                   BorderBrush="#E74C3C"
                   Margin="0,0,0,10">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#C0392B"/>
                                <Setter Property="Background" Value="#FADBD8"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icon -->
                    <TextBlock Grid.Column="0"
                              Text="↓"
                              FontSize="36"
                              VerticalAlignment="Center"
                              Margin="0,0,15,0"/>

                    <!-- Content -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Bulk Download and Process"
                                  FontSize="18"
                                  FontWeight="Bold"
                                  Margin="0,0,0,8"
                                  Foreground="#2C3E50"/>
                        <TextBlock TextWrapping="Wrap"
                                  Foreground="#7F8C8D"
                                  FontSize="12"
                                  LineHeight="18">
                            <Run Text="Download DWG files from provided links and process them with a custom command."/>
                        </TextBlock>
                    </StackPanel>

                    <!-- Button -->
                    <Button Grid.Column="2"
                           x:Name="BtnDownloadMode"
                           Content="Select"
                           Margin="15,0,0,0"
                           Padding="25,12"
                           VerticalAlignment="Center"
                           Background="#E74C3C"
                           Foreground="White"
                           FontSize="14"
                           FontWeight="Bold"
                           BorderThickness="0"
                           Click="BtnDownloadMode_Click"
                           Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#C0392B"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#ECF0F1" Padding="12">
            <TextBlock Text="💡 Tip: You can switch modes anytime from the menu" 
                      TextWrapping="Wrap" 
                      Foreground="#7F8C8D" 
                      FontSize="10" 
                      HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</Window>

