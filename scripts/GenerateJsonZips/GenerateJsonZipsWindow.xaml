<Window x:Class="BatchProcessor.Scripts.GenerateJsonZips.GenerateJsonZipsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Generate JSON Zips" Height="750" Width="900"
        MinHeight="500" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="200"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header with Back Button -->
            <Border Grid.Row="0" Background="#2C3E50" Padding="15" Margin="0,0,0,15" CornerRadius="5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" x:Name="BtnBack" Content="⬅" Width="40" Height="40" FontSize="20"
                            Background="Transparent" Foreground="White" BorderThickness="0"
                            Click="BtnBack_Click" Cursor="Hand" Margin="0,0,10,0"
                            ToolTip="Back to Mode Selection">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#34495E"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="📦 Generate JSON Zips" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock Text="Run drawing validations, pre-scrutiny and scrutiny commands then package outputs as zips" FontSize="12" Foreground="#ECF0F1" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Input/Output Paths -->
            <GroupBox Grid.Row="1" Header="📁 Folders" Margin="0,0,0,10" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Drawings Folder:" VerticalAlignment="Center" Margin="0,5,0,5"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtDrawingsFolder" Margin="5" Padding="5" VerticalAlignment="Center"/>
                    <Button Grid.Row="0" Grid.Column="2" Content="Browse..." Margin="5" Padding="5" Click="BtnBrowseDrawingsFolder_Click"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Output Folder:" VerticalAlignment="Center" Margin="0,5,0,5"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtOutputFolder" Margin="5" Padding="5" VerticalAlignment="Center"/>
                    <Button Grid.Row="1" Grid.Column="2" Content="Browse..." Margin="5" Padding="5" Click="BtnBrowseOutputFolder_Click"/>
                </Grid>
            </GroupBox>

            <!-- CSV Files -->
            <GroupBox Grid.Row="2" Header="📋 CSV Mapping Files" Margin="0,0,0,10" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="App Params CSV:" VerticalAlignment="Center" Margin="0,5,0,5"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtAppParamsCsv" Margin="5" Padding="5" VerticalAlignment="Center"/>
                    <Button Grid.Row="0" Grid.Column="2" Content="Browse..." Margin="5" Padding="5" Click="BtnBrowseAppParamsCsv_Click"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Workload Map CSV (optional):" VerticalAlignment="Center" Margin="0,5,0,5"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtWorkloadMapCsv" Margin="5" Padding="5" VerticalAlignment="Center"/>
                    <Button Grid.Row="1" Grid.Column="2" Content="Browse..." Margin="5" Padding="5" Click="BtnBrowseWorkloadMapCsv_Click"/>
                </Grid>
            </GroupBox>

            <!-- AutoCAD / DLL Settings -->
            <GroupBox Grid.Row="3" Header="⚙️ AutoCAD Settings" Margin="0,0,0,10" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>

                    <!-- Row 0: AutoCAD path -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="AutoCAD Path:" VerticalAlignment="Center" Margin="0,5,0,5"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtAutoCADPath" Margin="5" Padding="5" VerticalAlignment="Center"/>
                    <Button Grid.Row="0" Grid.Column="2" Content="Browse..." Margin="5" Padding="5" Click="BtnBrowseAutoCAD_Click"/>

                    <!-- Row 1: CommonUtils DLL (passes 1 & 2) -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="CommonUtils DLL:" VerticalAlignment="Center" Margin="0,5,0,5"
                               ToolTip="Used for Drawing File Validations and Pre-Scrutiny passes"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtCommonUtilsDll" Margin="5" Padding="5" VerticalAlignment="Center"/>
                    <Button Grid.Row="1" Grid.Column="2" Content="Browse..." Margin="5" Padding="5" Click="BtnBrowseCommonUtilsDll_Click"/>

                    <!-- Row 2: CRX DLL (pass 3) -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="CRX DLL:" VerticalAlignment="Center" Margin="0,5,0,5"
                               ToolTip="Used for Scrutiny Reports pass"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtCrxDll" Margin="5" Padding="5" VerticalAlignment="Center"/>
                    <Button Grid.Row="2" Grid.Column="2" Content="Browse..." Margin="5" Padding="5" Click="BtnBrowseCrxDll_Click"/>

                    <!-- Row 3: Max parallel -->
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Max Parallel:" VerticalAlignment="Center" Margin="0,5,0,5"/>
                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="TxtMaxParallel" Margin="5" Padding="5" VerticalAlignment="Center" Width="60" HorizontalAlignment="Left" Text="4"/>

                    <!-- Row 4: Verbose logging -->
                    <CheckBox Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" x:Name="ChkVerboseLogging"
                              Content="Verbose Logging" VerticalAlignment="Center" Margin="0,5,0,5"/>
                </Grid>
            </GroupBox>

            <!-- Action Buttons -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,10">
                <Button x:Name="BtnValidateMappings" Content="🔍 Validate Mappings" Padding="18,10" Margin="0,0,10,0"
                        Background="#E67E22" Foreground="White" FontSize="14" FontWeight="Bold" BorderThickness="0"
                        Click="BtnValidateMappings_Click" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#D35400"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="#BDC3C7"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button x:Name="BtnRun" Content="▶ Generate JSON Zips" Padding="18,10" Margin="0,0,10,0"
                        Background="#1ABC9C" Foreground="White" FontSize="14" FontWeight="Bold" BorderThickness="0"
                        Click="BtnRun_Click" Cursor="Hand" IsEnabled="False">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#16A085"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="#BDC3C7"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button x:Name="BtnCancel" Content="⏹ Cancel" Padding="18,10" Margin="0,0,10,0"
                        Background="#E74C3C" Foreground="White" FontSize="14" FontWeight="Bold" BorderThickness="0"
                        Click="BtnCancel_Click" Cursor="Hand" IsEnabled="False">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#C0392B"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="#BDC3C7"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button x:Name="BtnSaveSettings" Content="💾 Save Settings" Padding="18,10"
                        Background="#3498DB" Foreground="White" FontSize="14" FontWeight="Bold" BorderThickness="0"
                        Click="BtnSaveSettings_Click" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#2980B9"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

            <!-- Status -->
            <GroupBox Grid.Row="5" Header="📊 Status" Margin="0,0,0,10" Padding="10">
                <StackPanel>
                    <TextBlock x:Name="TxtStatus" Text="Ready. Validate mappings before running." TextWrapping="Wrap" FontSize="13"/>
                    <TextBlock x:Name="TxtExecutionTime" Text="" Foreground="#7F8C8D" FontSize="11" Margin="0,4,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </GroupBox>

            <!-- Skipped Drawings -->
            <GroupBox x:Name="GrpSkippedDrawings" Grid.Row="6" Header="⚠️ Skipped Drawings (no WorkloadID)" Margin="0,0,0,10" Padding="10" Visibility="Collapsed">
                <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="StkSkippedDrawings"/>
                </ScrollViewer>
            </GroupBox>

            <!-- Log Output -->
            <GroupBox Grid.Row="7" Header="📝 Log Output" Margin="0,0,0,10" Padding="10">
                <TextBox x:Name="TxtLog"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         FontSize="11"
                         Background="#1E1E1E"
                         Foreground="#D4D4D4"
                         Padding="5"/>
            </GroupBox>

            <!-- Footer -->
            <Border Grid.Row="8" Background="#ECF0F1" Padding="12" CornerRadius="5">
                <TextBlock Text="💡 Tip: First click 'Validate Mappings' to confirm all drawings are mapped, then click 'Generate JSON Zips' to run."
                          TextWrapping="Wrap" Foreground="#7F8C8D" FontSize="10" HorizontalAlignment="Center"/>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>
