<Window x:Class="BatchProcessor.Scripts.AnalyzeDrawings.AnalyzeDrawingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Analyze Drawings" Height="750" Width="900"
        MinHeight="500" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="200"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with Back Button -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="15" Margin="0,0,0,15" CornerRadius="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Back Button -->
                <Button Grid.Column="0" x:Name="BtnBack" Content="⬅" Width="40" Height="40" FontSize="20"
                        Background="Transparent" Foreground="White" BorderThickness="0"
                        Click="BtnBack_Click" Cursor="Hand" Margin="0,0,10,0"
                        ToolTip="Back to Mode Selection">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#34495E"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Title -->
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Analyze Drawings" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock Text="Analyze DWG drawings from download links or a local drawing folder" FontSize="12" Foreground="#ECF0F1" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Drawing Source and Folders -->
        <GroupBox Grid.Row="1" Header="Drawing Source and Folders" Margin="0,0,0,10" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>

                <!-- Source Selection -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Drawing Source:" VerticalAlignment="Center" Margin="0,5,0,5"/>
                <StackPanel Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="5">
                    <RadioButton x:Name="RbSourceLinks" Content="Download from links" GroupName="DrawingSource" IsChecked="True"
                                 VerticalAlignment="Center" Margin="0,0,20,0" Checked="SourceMode_Changed"
                                 ToolTip="Download DWG files from the URLs in the links file"/>
                    <RadioButton x:Name="RbSourceFolder" Content="Local drawing folder" GroupName="DrawingSource"
                                 VerticalAlignment="Center" Checked="SourceMode_Changed"
                                 ToolTip="Process all DWG files already present in a local folder (no download)"/>
                </StackPanel>

                <!-- Links File (links mode only) -->
                <TextBlock Grid.Row="1" Grid.Column="0" x:Name="LblLinksFile" Text="Links File:" VerticalAlignment="Center" Margin="0,5,0,5" ToolTip="Text file with download URLs (one per line)"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtLinksFile" Margin="5" Padding="5" VerticalAlignment="Center"/>
                <Button Grid.Row="1" Grid.Column="2" x:Name="BtnBrowseLinksFile" Content="Browse..." Margin="5" Padding="5" Click="BtnBrowseLinksFile_Click"/>

                <!-- Download Folder (links mode only) -->
                <TextBlock Grid.Row="2" Grid.Column="0" x:Name="LblDownloadFolder" Text="Download Folder:" VerticalAlignment="Center" Margin="0,5,0,5" ToolTip="Where downloaded DWG files are stored"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtDownloadFolder" Margin="5" Padding="5" VerticalAlignment="Center"/>
                <Button Grid.Row="2" Grid.Column="2" x:Name="BtnBrowseDownloadFolder" Content="Browse..." Margin="5" Padding="5" Click="BtnBrowseDownloadFolder_Click"/>

                <!-- Drawing Files Folder (drawing folder mode only) -->
                <TextBlock Grid.Row="3" Grid.Column="0" x:Name="LblDrawingFilesFolder" Text="Drawing Folder:" VerticalAlignment="Center" Margin="0,5,0,5" ToolTip="Local folder with the DWG files to process"/>
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="TxtDrawingFilesFolder" Margin="5" Padding="5" VerticalAlignment="Center"/>
                <Button Grid.Row="3" Grid.Column="2" x:Name="BtnBrowseDrawingFilesFolder" Content="Browse..." Margin="5" Padding="5" Click="BtnBrowseDrawingFilesFolder_Click"/>

                <!-- Output Folder -->
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Output Folder:" VerticalAlignment="Center" Margin="0,5,0,5"/>
                <TextBox Grid.Row="4" Grid.Column="1" x:Name="TxtOutputFolder" Margin="5" Padding="5" VerticalAlignment="Center"/>
                <Button Grid.Row="4" Grid.Column="2" Content="Browse..." Margin="5" Padding="5" Click="BtnBrowseOutputFolder_Click"/>
            </Grid>
        </GroupBox>

        <!-- DLL Path -->
        <GroupBox Grid.Row="2" Header="📦 DLL Path" Margin="0,0,0,10" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="DLL Path:" VerticalAlignment="Center" Margin="0,5,0,5"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtDllPath" Margin="5" Padding="5" VerticalAlignment="Center"/>
                <Button Grid.Row="0" Grid.Column="2" Content="Browse..." Margin="5" Padding="5" Click="BtnBrowseDll_Click"/>
            </Grid>
        </GroupBox>

        <!-- AutoCAD Settings -->
        <GroupBox Grid.Row="3" Header="🔧 AutoCAD Settings" Margin="0,0,0,10" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="AutoCAD Path:" VerticalAlignment="Center" Margin="0,5,0,5"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtAutoCADPath" Margin="5" Padding="5" VerticalAlignment="Center"/>
                <Button Grid.Row="0" Grid.Column="2" Content="Browse..." Margin="5" Padding="5" Click="BtnBrowseAutoCAD_Click"/>
            </Grid>
        </GroupBox>

        <!-- Processing Settings -->
        <GroupBox Grid.Row="4" Header="⚙️ Processing Settings" Margin="0,0,0,10" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Command Name -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Command Name:" VerticalAlignment="Center" Margin="0,5,0,5"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtCommandName" Margin="5" Padding="5" VerticalAlignment="Center" Text="RunPreScrutinyValidationsBatch"/>

                <!-- Max Parallel Processes -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Max Parallel:" VerticalAlignment="Center" Margin="0,5,0,5"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="5">
                    <TextBox x:Name="TxtMaxParallel" Width="100" Padding="5" Text="10" VerticalAlignment="Center"/>
                    <TextBlock Text="processes" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="Gray"/>
                </StackPanel>

                <!-- Verbose Logging -->
                <CheckBox Grid.Row="2" Grid.Column="1" x:Name="ChkVerbose" Content="Enable verbose logging" Margin="5" VerticalAlignment="Center"/>
            </Grid>
        </GroupBox>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,10">
            <Button x:Name="BtnRun" Content="▶ Analyze Drawings" Width="250" Height="40" FontSize="16" FontWeight="Bold"
                    Background="#E74C3C" Foreground="White" Click="BtnRun_Click" Margin="5"/>
        </StackPanel>

        <!-- Progress/Status -->
        <GroupBox Grid.Row="6" Header="📊 Status" Margin="0,0,0,10" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" x:Name="TxtStatus" Text="Ready to process..."
                           TextWrapping="Wrap"
                           FontWeight="SemiBold"
                           FontSize="12"
                           Padding="5"
                           MinHeight="30"/>
                <TextBlock Grid.Row="1" x:Name="TxtExecutionTime" Text=""
                           TextWrapping="Wrap"
                           FontWeight="Normal"
                           FontSize="11"
                           Foreground="#7F8C8D"
                           Padding="5,0,5,5"
                           Visibility="Collapsed"/>
            </Grid>
        </GroupBox>

        <!-- Log Output -->
        <GroupBox Grid.Row="7" Header="📝 Log Output" Margin="0,0,0,10" Padding="5">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBox x:Name="TxtLog" IsReadOnly="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" Background="#F8F9FA"
                         FontFamily="Consolas" FontSize="11" BorderThickness="0"/>
            </ScrollViewer>
        </GroupBox>

        <!-- Footer -->
        <Border Grid.Row="8" Background="#ECF0F1" Padding="10" CornerRadius="5">
            <TextBlock Text="💡 Tip: Create a text file with download URLs (one per line) before starting"
                       TextWrapping="Wrap" Foreground="#7F8C8D" FontSize="11" HorizontalAlignment="Center"/>
        </Border>
        </Grid>
    </ScrollViewer>
</Window>
